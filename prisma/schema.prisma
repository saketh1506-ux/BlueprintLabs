// BlueprintLabs Prisma Schema
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum CreationMethod {
  VOICE
  TEMPLATE
  SCRATCH
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  name         String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  projects     Project[]       @relation("OwnedProjects")
  memberships  ProjectMember[]
  activities   ActivityLog[]
}

model Project {
  id             String          @id @default(uuid())
  title          String
  creationMethod CreationMethod  @default(SCRATCH)
  ownerId        String
  owner          User            @relation("OwnedProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  joinCode       String          @unique
  isPublic       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  members        ProjectMember[]
  floorPlan      FloorPlan?
  activities     ActivityLog[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @default(EDITOR)
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
}

model FloorPlan {
  id          String   @id @default(uuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Int      @default(1)
  data        Json     // Structured vector floor plan (rooms, walls, doors, windows, furniture)
  thumbnail   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. "edited the kitchen in Dream Home"
  timestamp DateTime @default(now())
}
